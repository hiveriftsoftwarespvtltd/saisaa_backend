# ===============================
# JWT & TOKENS
# ===============================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=30d
JWT_EXPIRES_IN=7d

# ===============================
# DATABASE (MONGODB ATLAS)
# ===============================
MONGO_DB=saisaa_db
DB_NAME=saisaa_db
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/saisaa_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/saisaa_db?retryWrites=true&w=majority

# ===============================
# ADMIN CREDENTIALS
# ===============================
ADMIN_EMAIL=admin@saisaa.com
ADMIN_PASSWORD=ChangeMeInProduction123!

# ===============================
# EMAIL / SMTP SETTINGS
# ===============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
MAIL_FROM="SAISAA Atelier <no-reply@saisaa.com>"
CONTACT_RECEIVER_EMAIL=contact@saisaa.com

# ===============================
# RAZORPAY PAYMENT GATEWAY
# ===============================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ===============================
# SERVER
# ===============================
NODE_ENV=development
PORT=6001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://www.saisaa.com,https://saisaa.com
